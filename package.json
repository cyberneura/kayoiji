{
  "name": "kayoiji",
  "version": "0.3.0",
  "description": "Modeless Japanese/English input method for macOS",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "data": "bash scripts/fetch-data.sh && cargo run --release -p kayoiji-cli -- build-data",
    "test": "vitest run",
    "pad": "cd pad && tauri dev",
    "pad:build": "cd pad && tauri build"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
