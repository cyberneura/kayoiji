{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KayoijiPad",
  "mainBinaryName": "kayoiji-pad",
  "version": "0.6.0",
  "identifier": "com.cyberneura.KayoijiPad",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../build"
  },
  "app": {
    "windows": [
      {
        "label": "pad",
        "title": "KayoijiPad",
        "url": "pad",
        "width": 640,
        "height": 440
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.icns",
      "../../src-tauri/icons/icon.ico"
    ],
    "externalBin": ["../../data/build/english-check"],
    "resources": {
      "../../data/build/kayoiji.dict": "data/kayoiji.dict",
      "../../data/build/english.fst": "data/english.fst",
      "../../data/build/symbols.dict": "data/symbols.dict",
      "../../data/build/emoji.dict": "data/emoji.dict",
      "../../data/build/emoji.json": "data/emoji.json"
    }
  }
}
