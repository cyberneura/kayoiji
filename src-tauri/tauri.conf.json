{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kayoiji",
  "mainBinaryName": "kayoiji",
  "version": "0.6.3",
  "identifier": "com.cyberneura.inputmethod.Kayoiji",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["../data/build/english-check"],
    "resources": {
      "../data/build/kayoiji.dict": "data/kayoiji.dict",
      "../data/build/english.fst": "data/english.fst",
      "icons/menu-icon.pdf": "menu-icon.pdf",
      "lproj/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "lproj/ja.lproj/InfoPlist.strings": "ja.lproj/InfoPlist.strings",
      "icons/menu-icon-japanese.pdf": "menu-icon-japanese.pdf",
      "../data/build/symbols.dict": "data/symbols.dict",
      "../data/build/emoji.dict": "data/emoji.dict",
      "../data/build/emoji.json": "data/emoji.json",
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    }
  }
}
